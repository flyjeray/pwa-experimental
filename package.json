{
  "name": "pwa-experimental",
  "version": "1.0.0",
  "description": "Experimental PWA project",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "npm run build:wrapper && npm run build:frontend",
    "build:wrapper": "npm run build --workspace=supabase-wrapper",
    "build:frontend": "npm run build --workspace=frontend-react",
    "dev": "npm run build:wrapper && npm run dev --workspace=frontend-react",
    "preview": "npm run build:wrapper && npm run preview --workspace=frontend-react",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "prepare": "husky",
    "db:pull": "cd supabase && supabase db pull",
    "db:push": "cd supabase && supabase db push",
    "gen:types": "cd supabase && supabase gen types typescript --linked > database.types.ts",
    "migration": "cd supabase && supabase migration new"
  },
  "workspaces": [
    "frontend-react",
    "supabase-wrapper",
    "supabase"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.45.0"
  }
}
